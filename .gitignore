# Repositories working area
/server/repos/*
!/server/repos/.gitkeep

# Storage and generated packages
/server/storage/releases/*
!/server/storage/releases/.gitkeep
/server/storage/tmp/*
!/server/storage/tmp/.gitkeep
/server/storage/locks/*
!/server/storage/locks/.gitkeep

# Logs
/server/storage/logs/*
!/server/storage/logs/.gitkeep
/logs/*
!/logs/.gitkeep
*.log
/DecisionLog/*

# Test temporary storage and logs
/tests/temp_storage/*
!/tests/temp_storage/.gitkeep
/tests/logs/*
!/tests/logs/.gitkeep

# Dependencies
/vendor/

# Local Environment Configurations
config/branches.local.json
.env
.env.local

# OS / Editor temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.ai_rules.md
WIP_STATE.md
